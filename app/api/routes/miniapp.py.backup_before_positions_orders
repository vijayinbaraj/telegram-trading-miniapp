@router.post("/login-code")
async def login_code(body: GoogleCodeAuthInput, request: Request):
    tg = _telegram_identity(body.init_data)

    google = await exchange_google_authorization_code(
        body.code,
        request.headers.get("origin"),
        request.headers.get("x-requested-with"),
    )

    # Validate that this Google account belongs to this Telegram user.
    user = login_google_customer(
        google,
        tg["telegram_user_id"],
    )

    # Create authenticated session.
    token = issue_session(user)

    try:
        await send_message(
            tg["telegram_user_id"],
            "Login successful. Your session is valid for seven days.",
            authenticated_keyboard(),
        )
    except Exception:
        pass

    return {
        "ok": True,
        "access_token": token,
        "token_type": "bearer",
        "user": {
            "email": user["email"],
            "full_name": user.get("full_name"),
            "exchange": "PAPER" if user["paper_testing"] else "LIVE",
        },
    }

@router.post("/mobile/google/start")
def mobile_google_start(body: MobileOAuthStartInput):
    tg = _telegram_identity(body.init_data)
    transaction = create_mobile_oauth_transaction(
        telegram_user_id=tg["telegram_user_id"],
        purpose=body.purpose,
        paper_testing=body.paper_testing,
    )
    return transaction


@router.get("/mobile/google/callback", response_class=HTMLResponse)
async def mobile_google_callback(
    code: str | None = None,
    state: str | None = None,
    error: str | None = None,
):
    if error:
        return HTMLResponse(
            "<!doctype html><html><body style='font-family:Arial;text-align:center;padding:40px'>"
            "<h2>Google sign-in was cancelled</h2><p>Return to Telegram and try again.</p></body></html>",
            status_code=400,
        )
    if not code or not state:
        return HTMLResponse(
            "<!doctype html><html><body style='font-family:Arial;text-align:center;padding:40px'>"
            "<h2>Unable to complete sign-in</h2><p>Missing Google authorization response. Return to Telegram.</p></body></html>",
            status_code=400,
        )
    try:
        transaction = claim_mobile_oauth_callback(state)
        await complete_mobile_oauth_callback(transaction, code)
    except HTTPException as exc:
        message = str(exc.detail).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
        return HTMLResponse(
            "<!doctype html><html><body style='font-family:Arial;text-align:center;padding:40px'>"
            f"<h2>Sign-in could not be completed</h2><p>{message}</p>"
            "<p>Return to Telegram and try again.</p></body></html>",
            status_code=exc.status_code,
        )
    return HTMLResponse(
        "<!doctype html><html><head><meta name='viewport' content='width=device-width,initial-scale=1'></head>"
        "<body style='font-family:Arial;text-align:center;padding:40px'>"
        "<h2>Google verification complete</h2>"
        "<p>Return to Telegram. Your Mini App will finish signing you in.</p></body></html>"
    )


@router.post("/mobile/google/consume")
async def mobile_google_consume(body: MobileOAuthConsumeInput):
    result = consume_mobile_oauth_transaction(body.transaction_id, body.poll_secret)
    if result.get("status") == "complete":
        # The transaction has already been atomically consumed and the session created.
        # Telegram notification is best-effort and does not affect authentication.
        try:
            from app.db import fetch_one
            user = fetch_one(
                "SELECT telegram_chat_id FROM app_user WHERE email=%s",
                (result["user"]["email"],),
            )
            if user:
                await send_message(
                    user["telegram_chat_id"],
                    "Login successful. Your session is valid for seven days.",
                    authenticated_keyboard(),
                )
        except Exception:
            pass
    elif result.get("status") == "registered":
        try:
            from app.db import fetch_one
            user = fetch_one(
                "SELECT telegram_chat_id FROM app_user WHERE email=%s",
                (result["user"]["email"],),
            )
            if user:
                await send_message(
                    user["telegram_chat_id"],
                    "Registration successful. Please return to the Mini App and log in.",
                    login_keyboard(),
                )
        except Exception:
            pass
    return result


