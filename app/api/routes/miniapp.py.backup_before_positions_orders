def _telegram_identity(init_data: str):
    tg = validate_init_data(init_data)
    if not tg:
        raise HTTPException(401, "Invalid or expired Telegram Mini App data")
    return tg


@router.post("/auth/status")
def auth_status(body: dict):
    init_data = body.get("init_data", "") if isinstance(body, dict) else ""
    tg = _telegram_identity(init_data)
    state = registration_status(tg["telegram_user_id"])
    if state["status"] == "login":
        user = find_linked_user(tg["telegram_user_id"])
        from app.db import fetch_one
        active = fetch_one(
            "SELECT 1 AS ok FROM user_session WHERE user_id=%s AND expires_at>(NOW() AT TIME ZONE 'UTC') LIMIT 1",
            (user["id"],),
        )
        state["authenticated"] = bool(active)
    else:
        state["authenticated"] = False
    return state



@router.post("/register/password")
async def register_password(body: PasswordRegisterInput):
    tg = _telegram_identity(body.init_data)
    email = body.email.strip().lower()
    if not re.fullmatch(r"[^@\s]+@gmail\.com", email, flags=re.IGNORECASE):
        raise HTTPException(400, "Please enter a valid Gmail address ending in @gmail.com.")
    user = register_password_customer(
        email, body.password, tg["telegram_user_id"], body.paper_testing
    )
    try:
        await send_message(
            tg["telegram_user_id"],
            "Registration successful. You can now log in with your Gmail address and password.",
            login_keyboard(),
        )
    except Exception:
        pass
    return {
        "ok": True,
        "registered": True,
        "message": "Registration successful. You can now log in with your Gmail address and password.",
        "user": {
            "email": user["email"],
            "full_name": user.get("full_name"),
            "exchange": "PAPER" if user["paper_testing"] else "LIVE",
        },
    }


@router.post("/login/password")
async def login_password(body: PasswordLoginInput):
    tg = _telegram_identity(body.init_data)
    email = body.email.strip().lower()
    if not re.fullmatch(r"[^@\s]+@gmail\.com", email, flags=re.IGNORECASE):
        raise HTTPException(400, "Please enter a valid Gmail address ending in @gmail.com.")
    user = login_password_customer(email, body.password, tg["telegram_user_id"])
    token = issue_session(user)
    try:
        await send_message(
            tg["telegram_user_id"],
            "Login successful. Your session is valid for seven days.",
            authenticated_keyboard(),
        )
    except Exception:
        pass
    return {
        "ok": True,
        "access_token": token,
        "token_type": "bearer",
        "user": {
            "email": user["email"],
            "full_name": user.get("full_name"),
            "exchange": "PAPER" if user["paper_testing"] else "LIVE",
        },
    }


@router.post("/register")
async def register(body: RegisterInput):
    tg = _telegram_identity(body.init_data)
    google = verify_google_id_token(body.credential)
    user = register_google_customer(google, tg["telegram_user_id"], body.paper_testing)
    try:
        await send_message(tg["telegram_user_id"], "Registration successful. Please log in with Google to continue.", login_keyboard())
    except Exception:
        pass  # Registration is committed; the next /start refreshes the keyboard.
    return {"ok": True, "registered": True, "message": "Registration successful. Return to Telegram and press Login.",
            "user": {"email": user["email"], "full_name": user.get("full_name"),
                     "exchange": "PAPER" if user["paper_testing"] else "LIVE"}}


@router.post("/register-code")
async def register_code(body: GoogleCodeRegisterInput, request: Request):
    tg = _telegram_identity(body.init_data)

    google = await exchange_google_authorization_code(
        body.code,
        request.headers.get("origin"),
        request.headers.get("x-requested-with"),
    )

    # Create the customer using the existing registration rules.
    # Tenant assignment remains controlled by default_tenant_id (110).
    user = register_google_customer(
        google,
        tg["telegram_user_id"],
        body.paper_testing,
    )

    try:
        await send_message(
            tg["telegram_user_id"],
            "Registration successful. Please log in with Google to continue.",
            login_keyboard(),
        )
    except Exception:
        pass

    return {
        "ok": True,
        "registered": True,
        "message": "Registration successful. Return to Telegram and press Login.",
        "user": {
            "email": user["email"],
            "full_name": user.get("full_name"),
            "exchange": "PAPER" if user["paper_testing"] else "LIVE",
        },
    }


